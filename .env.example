# Переменные окружения. Реальные значения вписываются только в панель Secrets в Replit,
# никогда не в этот файл и не в чат.

# Строка подключения к PostgreSQL (в Replit создаётся автоматически при подключении Replit Postgres)
DATABASE_URL=

# Секрет для подписи сессий/JWT пользователей — любая длинная случайная строка
SESSION_SECRET=

# Аварийный код восстановления доступа администратора (см. PASSPORT.md, блок 6, lockout-сценарий)
ADMIN_RECOVERY_CODE=

# Одноразовая настройка первого администратора для новой production-базы.
# Пароль должен содержать не менее 16 символов. Удалите эти значения после первого запуска.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
